<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <CargoPackage>sb_pp_ffi</CargoPackage>
        <CargoBindingsPackage>sb_pp_ffi_build</CargoBindingsPackage>
        <CargoWorkspacePath>$(MSBuildThisFileDirectory)/../../</CargoWorkspacePath>
    </PropertyGroup>

    <!-- 非 Windows 直接报错 -->
    <Target Name="CheckWindowsOnly" BeforeTargets="BeforeBuild">
        <Error
            Condition=" '$([MSBuild]::IsOsPlatform(`WINDOWS`))' != 'true' "
            Text="This project only supports Windows." />
    </Target>

    <!-- 32位 / 64位 判断
         优先读取外部传入的 NativeArch 属性（win-x86 / win-x64）；
         若未传入则回退到 PlatformTarget / PROCESSOR_ARCHITECTURE。
         命令行强制指定示例：/p:NativeArch=win-x86 -->
    <PropertyGroup Condition=" '$(NativeArch)' == 'win-x64'
                             Or ('$(NativeArch)' == ''
                                 And ('$(PlatformTarget)' == 'x64'
                                      Or '$(PROCESSOR_ARCHITECTURE)' == 'AMD64')) ">
        <IsWin64>true</IsWin64>
        <CargoTarget>x86_64-pc-windows-msvc</CargoTarget>
        <DefineConstants>$(DefineConstants);WINDOWS;WIN64</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(NativeArch)' == 'win-x86'
                             Or ('$(NativeArch)' == '' And '$(IsWin64)' != 'true') ">
        <IsWin64>false</IsWin64>
        <CargoTarget>i686-pc-windows-msvc</CargoTarget>
        <DefineConstants>$(DefineConstants);WINDOWS;WIN32</DefineConstants>
    </PropertyGroup>

    <!-- Cargo 配置 -->
    <PropertyGroup>
        <CargoTargetPath>$(MSBuildThisFileDirectory)/../../target</CargoTargetPath>
        <CargoConfiguration>release</CargoConfiguration>
        <CargoArtifact>$(CargoPackage).dll</CargoArtifact>
        <CargoArtifactPath>$(CargoTargetPath)/$(CargoTarget)/$(CargoConfiguration)/$(CargoArtifact)</CargoArtifactPath>
    </PropertyGroup>

    <ItemGroup>
        <CargoChannelArg Condition=" '$(CargoChannel)' != '' " Include="+$(CargoChannel)" />
        <CargoBuildArg Include="--target $(CargoTarget)" />
        <CargoBuildArg Condition=" '$(CargoConfiguration)' == 'release' " Include="--release" />
    </ItemGroup>

    <!-- 编译 Rust 库 -->
    <Target Name="Cargo" DependsOnTargets="CheckWindowsOnly" BeforeTargets="BeforeBuild">
        <Message Text="Building libs ($(CargoTarget))" Importance="high" />
        <Exec Command="cargo @(CargoChannelArg, ' ') build @(CargoBuildArg, ' ') -p $(CargoPackage)"
              WorkingDirectory="$(CargoWorkspacePath)" />
        <Message Text="Generate Bindings" Importance="high" />
        <Exec Command="cargo @(CargoChannelArg, ' ') build @(CargoBuildArg, ' ') -p $(CargoBindingsPackage)"
              WorkingDirectory="$(CargoWorkspacePath)" />
    </Target>

    <!-- 复制 DLL 到输出目录 -->
    <Target Name="CargoBuildCopy" DependsOnTargets="Cargo" BeforeTargets="BeforeBuild">
        <Message Text="Copy native libs ($(CargoTarget))" Importance="high" />
        <ItemGroup>
            <Content Include="$(CargoArtifactPath)">
                <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    </Target>
</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RosuPP</RootNamespace>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <UsePrebuiltNativeArtifacts Condition=" '$(NativeArtifactsRoot)' != '' ">true</UsePrebuiltNativeArtifacts>
  </PropertyGroup>

  <ItemGroup Condition=" '$(NativeArtifactsRoot)' != '' ">
    <None Include="$(NativeArtifactsRoot)/rosu-pp-native-win-x64/rosu_pp_ffi.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native" />
    <None Include="$(NativeArtifactsRoot)/rosu-pp-native-win-arm64/rosu_pp_ffi.dll"
          Pack="true"
          PackagePath="runtimes/win-arm64/native" />
    <None Include="$(NativeArtifactsRoot)/rosu-pp-native-linux-x64/librosu_pp_ffi.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native" />
    <None Include="$(NativeArtifactsRoot)/rosu-pp-native-linux-arm64/librosu_pp_ffi.so"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native" />
    <None Include="$(NativeArtifactsRoot)/rosu-pp-native-osx-x64/librosu_pp_ffi.dylib"
          Pack="true"
          PackagePath="runtimes/osx-x64/native" />
    <None Include="$(NativeArtifactsRoot)/rosu-pp-native-osx-arm64/librosu_pp_ffi.dylib"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native" />
  </ItemGroup>

  <Import Project="./Rosu.targets" />
</Project>
